# === Audit Engine — Variables d'environnement ===
# Copier ce fichier en .env.local et compléter

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Scanner ---
# Timeout du scan d'un site (millisecondes)
SCANNER_TIMEOUT_MS=30000
# User-agent du scanner (pour s'identifier comme bot honnête)
SCANNER_USER_AGENT="Mozilla/5.0 AuditEngine/1.0 MSDN-Consulting"

# --- IA (pour génération registre des traitements en v2) ---
ANTHROPIC_API_KEY=

# --- Base de données (v2, pas utilisé en MVP) ---
# DATABASE_URL=postgresql://localhost:5432/audit_engine

# --- CRM (v3) ---
# PIPEDRIVE_API_TOKEN=
